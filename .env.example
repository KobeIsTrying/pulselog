# PulseLog environment contract.
# Copy to .env for local host-run binaries. Never commit real secrets.
#
# Categories: required | optional | development-only | production-only | secret

# --- Runtime (optional) ---
ENV=development
LOG_LEVEL=info

# --- Ingestion API (optional; defaults are local-safe) ---
HTTP_ADDR=:8080
HTTP_MAX_BODY_BYTES=5242880

# --- Kafka (required for ingest + processor) ---
# Host machine: localhost:9092
# Docker network: kafka:19092
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_INGEST=logs-ingest
KAFKA_TOPIC_DLQ=logs-dlq
KAFKA_CONSUMER_GROUP=log-processor
KAFKA_WRITE_TIMEOUT=5s

# --- Log processor (optional) ---
PROCESSOR_HTTP_ADDR=:8081
PROCESSOR_BATCH_SIZE=100
PROCESSOR_BATCH_TIMEOUT=500ms
PROCESSOR_MAX_ATTEMPTS=5
PROCESSOR_RETRY_BACKOFF=200ms
PROCESSOR_SHUTDOWN_GRACE=15s
CLICKHOUSE_WRITE_TIMEOUT=10s
CLICKHOUSE_TABLE=logs

# --- ClickHouse ---
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=pulselog
CLICKHOUSE_USER=pulselog
# secret — local placeholder only
CLICKHOUSE_PASSWORD=pulselog_dev_only
# optional — raw log retention; default 90 days. Do not leave logs forever.
CLICKHOUSE_TTL_DAYS=90
CLICKHOUSE_MV_TTL_DAYS=180

# --- Query API (optional) ---
QUERY_HTTP_ADDR=:8082
QUERY_TIMEOUT=5s
# Per-subscriber hub buffer. Not an unbounded queue. Bench-only override: WS_HUB_BUFFER=1024
WS_HUB_BUFFER=256

# --- PostgreSQL (required for identity) ---
# secret — local placeholder only
POSTGRES_DSN=postgres://pulselog:pulselog_dev_only@localhost:5432/pulselog?sslmode=disable
POSTGRES_USER=pulselog
POSTGRES_PASSWORD=pulselog_dev_only
POSTGRES_DB=pulselog

# --- Redis (required for rate limits, JWT denylist; optional for live fanout) ---
REDIS_ADDR=localhost:6379

# --- Auth ---
# secret — local-only placeholder. Generate a long random value before any non-local deploy.
JWT_SECRET=pulselog_dev_jwt_only
JWT_TTL=24h
# development-only convenience. Production recommendation: AUTH_SIGNUPS=false
AUTH_SIGNUPS=true
# Required for browser WebSockets from the dashboard. Production: explicit HTTPS origins. Never *.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Rate limits (fixed window, Redis). Production defaults stay conservative. ---
# Do not copy Phase 7 bench values (1_000_000) into production.
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_WINDOW=1m
RATE_LIMIT_INGEST=120
RATE_LIMIT_INGEST_WINDOW=1m
RATE_LIMIT_QUERY=120
RATE_LIMIT_QUERY_WINDOW=1m

# --- Dashboard (Next.js) ---
# Copy apps/dashboard/.env.example to apps/dashboard/.env.local for npm run dev.
# QUERY_API_URL=http://127.0.0.1:8082
# QUERY_WS_PUBLIC_URL is runtime (container); NEXT_PUBLIC_QUERY_WS_URL is local-dev fallback.
# COOKIE_SECURE=false on local HTTP; true behind HTTPS.

# --- Production-only (see .env.prod.example) ---
# ENV=production
# AUTH_SIGNUPS=false
# COOKIE_SECURE=true
# CORS_ORIGINS=https://pulselog.example.com
# QUERY_WS_PUBLIC_URL=wss://api.pulselog.example.com/api/v1/stream
