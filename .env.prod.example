# Production-like / portfolio Compose secrets.
# Copy to .env.prod (gitignored) and replace every placeholder.
# Never commit real credentials.
#
# Required for: docker compose --env-file .env.prod -f infrastructure/docker-compose.prod.yml up -d --build

# --- Runtime ---
ENV=production
LOG_LEVEL=info

# --- Secrets (required) ---
JWT_SECRET=replace-with-a-long-random-value
POSTGRES_USER=pulselog
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=pulselog
POSTGRES_DSN=postgres://pulselog:replace-with-a-strong-password@postgres:5432/pulselog?sslmode=disable
CLICKHOUSE_USER=pulselog
CLICKHOUSE_PASSWORD=replace-with-a-strong-password
CLICKHOUSE_DATABASE=pulselog

# --- Production auth / CORS ---
# Production recommendation: keep signups closed and invite users out of band.
AUTH_SIGNUPS=false
# Browser origins that may open WebSockets / CORS. Do not use *.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Public WebSocket URL as seen by the browser (runtime, not baked into the image).
QUERY_WS_PUBLIC_URL=ws://127.0.0.1:8082/api/v1/stream
# false for local HTTP demo; true behind HTTPS.
COOKIE_SECURE=false

# --- Retention ---
CLICKHOUSE_TTL_DAYS=90
CLICKHOUSE_MV_TTL_DAYS=180

# --- Rate limits (safe defaults; do not copy Phase 7 bench 1000000) ---
RATE_LIMIT_LOGIN=10
RATE_LIMIT_INGEST=120
RATE_LIMIT_QUERY=120
WS_HUB_BUFFER=256

# --- Optional observability profile ---
# GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
